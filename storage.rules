rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {

    // Anexos do Quadro de Demandas (Kanban): imagens e prints da demanda e dos
    // comentários. Espelha o feluma-on: PNG/JPEG/WebP/PDF, no máximo 5 MB.
    // Leitura exige apenas autenticação; escrita valida tipo e tamanho.
    function anexoKanbanValido() {
      return request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|webp)')
            || request.resource.contentType == 'application/pdf');
    }

    match /kanban-images/{cardId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && anexoKanbanValido();
    }

    match /kanban-comment-images/{cardId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && anexoKanbanValido();
    }

    // Demais caminhos permanecem bloqueados.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
