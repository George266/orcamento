rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global: Exige autenticação para qualquer leitura ou escrita
    // Em produção, isso deve ser refinado para checar perfis (ex: admin)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Regras específicas (opcional, para futura expansão de segurança)
    match /usuarios/{userId} {
      allow read, write: if request.auth != null;
    }

    match /institutos/{instId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /procedimentos/{procId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /programas/{progId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /pactuacoes/{pactId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}